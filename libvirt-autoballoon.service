[Unit]
Description=libvirt-autoballoon
After=local-fs.target
ConditionPathExists=/etc/libvirt/autoballoon.json

[Service]
Type=simple
ExecStart=/usr/bin/libvirt-autoballoon start
Nice=19
SuccessExitStatus=143
OOMScoreAdjust=-999
Restart=always
MemoryHigh=16M
MemoryMax=64M
ProtectSystem=true
ProtectHome=true
PrivateTmp=yes

[Install]
WantedBy=local-fs.target
